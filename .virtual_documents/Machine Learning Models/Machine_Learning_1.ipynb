#supervised Learning Example using the Simple Linear Regression

import matplotlib.pyplot as plt 
import pandas as pd 
import numpy as np 

rng = np.random.RandomState(42)
x = 10*rng.rand(50)
y = 2*x-1+rng.rand(50)
plt.scatter(x,y)


from sklearn.linear_model import LinearRegression #importing the model 


#setting up a model 
model  = LinearRegression(fit_intercept = True)
model



#making the data representation in the x and y form 
X = x[:,np.newaxis]


#fitting the x and y data into the model 
model.fit(X,y)#here X is we maked for the simple Linear Regression and y and is the data of simple Linear Regression as well 
LinearRegression()


#slope and intercept of the model 
model.coef_


model.intercept_


#new data of the x to predict the y values 
xfit = np.linspace(-1,11)
Xfit = xfit[: , np.newaxis]# this is the data that we have to predict the value of  
yfit = model.predict(Xfit)


#lets visualise how much of the thienew yfit data is accurate that we have trainded onthe model 









