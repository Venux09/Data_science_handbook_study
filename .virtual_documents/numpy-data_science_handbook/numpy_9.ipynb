#checking the time of sum function of the python and the numpy function 


import numpy as np 
a = np.arange(1,100000000)


%timeit np.sum(a)


#minimum and maximum 


b = np.random.random(100)


%timeit min(b)


%timeit np.min(b)


#here we can observe that time for the python function function is way more than the numpy function


#multidimensional array 


c = np.random.random((3,4))


c


np.sum(c)


c.sum()


c.min(axis = 0)


c.max(axis = 1)


np.argmax(c)


np.argmin(c)


np.mean(c,axis=0)


d = np.mean(c,axis=1)


d.argmax()


d


d.std()


d.mean()


#here we can see that std and mean are not at all identical means that there is too much gap between the value in the data


np.nanmin(d)


#can use the nan iteratble fuction to aviod the empty spaces 


np.prod(d)#multiplying the values present in the numpy array


