


name = ['Alice', 'Bob', 'Cathy', 'Doug']
age = [25, 45, 37, 19]
weight = [55.0, 85.5, 68.0, 61.5]


#we have created our own array to fit in the in the things as the data types 
import numpy as np 
data = np.zeros(4,dtype={'names':('name','age','weight'),
                        'formats':('U10','i4','f8')})


data.dtype


data['name'] = name
data['age']  = age 
data['weight'] = weight


data['name']


data


data[0]


data[['name','age']]


data[data['age']<30]['name']








#other ways to create the structured array data types are 
data_types=np.dtype([('name','U10'),('age','i4'),('weight','f8')])


#now creatinng an array on our structured data types 
data = np.zeros(4,dtype = data_types)


# data[['name','weight','age']] = name , weight, age





np = np.zeros(1, dtype= data_types)


np['name'] = 'monu' 
np['age'] = 17 
np['weight'] = 70


np





