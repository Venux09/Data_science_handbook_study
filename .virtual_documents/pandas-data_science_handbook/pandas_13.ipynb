date.strftime('%B')


#type of array of times 


import numpy as np 
date = np.array('2026-07-12',dtype = np.datetime64)#data type of the dates


date


date + np.arange(366)#settinng the range of the number dayys 
#it works according to the real format of date and times on the earth


np.datetime64('2026-09-18')#date based 


np.datetime64('2026-09-18 08:45')#minutes based 


np.datetime64('2026-09-18 08:45:10')#seconds based datetime data 



