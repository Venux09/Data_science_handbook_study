data_2.loc[3]


#difference between the normal indexing and loc indexing is that in normal indexing it do not care about objecct , integer etc we can do either way usiongn objects or integers
#but in the loc indexing it will do indexig using the actual indexes not random , natural numbers or etcc 





data_3  = pd.Series(['a','b','c'],
                   ['a','b','d'])


data_3


data_3.loc[2]#it is givinng error because 2 is not actual index


data_3[2]#it is giving even 2 is not integer which makes confusion 


data_3.loc['a':'d']#now it is giving the actual values and we can see that it has actual these indexes in the range 


