import pandas as pd 
import numpy as np 



#the pandas index object 


ind = pd.Index([1,2,3,4,5])
ind


ind[1] = 1#here we get to know pandas index is immutable 


ind.shape,ind.size,ind.ndim


# they perform same as the numpy array but the difference is they are immutable and numpy array are mutable





ind


ind_2 = pd.Index([1,2,4,5,6])
ind_2


ind_2 & ind#intersectoin function of the sets 


ind_2 | ind #union function of the sets 


ind ^ ind_2


ind.intersection(ind_2)


ind.union(ind_2)


ind.symmetric_difference(ind_2)


ind.difference(ind_2)





