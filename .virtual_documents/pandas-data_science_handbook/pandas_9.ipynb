df6 = pd.DataFrame({'name': ['Peter', 'Paul', 'Mary'],
'food': ['fish', 'beans', 'bread']},
columns=['name', 'food'])
df7 = pd.DataFrame({'name': ['Mary', 'Joseph'],
'drink': ['wine', 'beer']},
columns=['name', 'drink'])


df6


df7


pd.merge(df6,df7)#here only one thing is common that why only mary is comming 


#trying the inner 
pd.merge(df6,df7,how='inner')


#lets try outer ones so nan can be produced 
pd.merge(df6,df7,how='outer')


#on the basis of the left 
pd.merge(df6,df7,how = "left")


#overlapping  column names 


df8 = pd.DataFrame({'name': ['Bob', 'Jake', 'Lisa', 'Sue'],
'rank': [1, 2, 3, 4]})
df9 = pd.DataFrame({'name': ['Bob', 'Jake', 'Lisa', 'Sue'],
'rank': [3, 1, 4, 2]})


#so basically here we can see that there is conflicting columns names where there is two different types of ranks 
display('df8','df9','pd.merge(df8,df9,on="name")')


#here we seen a interseting things on the  basis that there was conflicting columns merge functoin itselt setted the values value_x and value_y on the basis of itself


#setting the suffix ourself 
pd.merge(df8,df9,on='name',suffixes = ['_L','_y'])






