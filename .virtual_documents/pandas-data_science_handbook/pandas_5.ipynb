


#None pythonic missing data and Null pandas missing data 


import pandas as pd 
import numpy as np 


val1 = np.array([1,2,None,3,4])


val1


for dtype in ['object','int']:
    print(f'dtype = {dtype}')
    %timeit np.arange(1E6,dtype = dtype ).sum()
    print()


val1.sum()#such as thse aggregation function doesnotwork on differenet data types 


val2 = np.array([1,2,3,4,np.nan])


val2


val2.sum()


val2.dtype


#Nan is like virus it affects other values also that is other than in the case 


#Nan we can perform function while nan is present 


#for ignoring the nan itself we can perform aggregate 


np.nansum(val2)


np.nanmin(val2)


np.nanmax(val2)


np.nanargmax(val2)


#so we can perform function using numpy in this case 


val1


val1[2] = 1


val1


val1 


val1.dtype


x = pd.Series(np.arange(2,dtype = int))


x


x[0] = None


x


#so here we can see that it has been changing the data type to the float so we can expect that nan is a float values that why it is changing the dtype of the pandas series 


#so nan dont change the data type of the floats and objects 


#operatoin on the null values 


data = pd.Series([1, np.nan, 'hello', None])


data


data.isnull()


data.notnull()


data[data.notnull()]


data[data.isnull()]


#for dropping the na values 
data.dropna()



#for filling the na values in the data 
data.fillna(0)


df = pd.DataFrame([[1, np.nan, 2],
[2, 3, 5],
[np.nan, 4, 6]])


df


#here we ccnot not drop one value it will either drop the row or full colunmns


df.dropna()


#dropping na value in the columns wise 
df.dropna(axis = 1)


#different ways to filling the values 
df.fillna(method = 'ffill')


df.fillna('ffill')


df.ffill()


df.fillna(0)


df.bfill()


df


df.bfill(axis = 1)


df.bfill()


df.ffill(axis=1)


df.fillna(0.000)






