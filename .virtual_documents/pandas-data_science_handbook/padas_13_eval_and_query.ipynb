


import numpy as np 
rng = np.random.RandomState(42)
x = rng.random(1000000)
y = rng.random(1000000)
%timeit x+y


#so doing this with the python is waste as it takes a lot time than this one 


#usinng simple maskging in this is also waste because it do breakdown and run the things seprately then it come to the operation it can 
#cause the memory overalload for that high perfoormative tool are used called evall and query


#lets do the computation using the eval 
import pandas as pd 
nrows , ncoloumns = 1000000,100
df1,df2,df3,df4 = (pd.DataFrame(rng.random((nrows,ncoloumns))) for i in range (4))
#doing simple numpy style computation 
%timeit df1+df2+df3+df4


#doing the same computation using the eval of the pandas 

%timeit pd.eval('df1  + df2 + df3 + df4')


#pd.eval performed the funcction 2x faster that is the big thing when you work with the billions of the rows 


#operation from the eval 


#integers 
df1, df2, df3, df4, df5 = (pd.DataFrame(rng.randint(0,1000,(100,3))) for i in range (5))


#doing the arithmatic operators 
result_1 = -df1*df2/(df1*df2)
result_2 = df1 + df2 + df3 + df4/(df1 + df2+ df3+ df4)


np.allclose(result_1,result_2)#since they are not equal on the terms 


#comparison operators 
result_1 = (df1<df2) & (df2<=df3) & (df3!=df4)
result_2 = pd.eval('df1<df2 <= df3 != df4')


np.allclose(result_1,result_2)


#bitwise operators & and |
result_3 = (df1 < 0.5) & (df2 < 0.5) | (df3 < df4)

result_4 = ('(df1 < 0.5) & (df2 < 0.5) | (df3 < df4)')


%xmode Verbose
#np.allclose(result_3 , result_4)


#pd.eval can also support the index wise operation as well 


#Dataframe.eval for the column wise operators 


df = pd.DataFrame(rng.random((3000,3)) , columns = ['A' , 'B' , 'C'])


df.head()


df.describe()


result1 = (df['A']+df['B'])/(df['C'] - 1)
result2 = pd.eval('(df.A + df.B) / (df.C - 1)')


np.allclose(result1,result2)


#checking new way to writing the column using the eval from the book
result3  = df.eval('(A+B)/(C-1)')


np.allclose(result2,result3)


np.allclose(result1,result3)


#so there are total three method an column wise operation can be performed 



