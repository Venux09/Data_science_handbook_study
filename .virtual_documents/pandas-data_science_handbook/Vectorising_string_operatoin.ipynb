import pandas as pd 
import numpy as np 


recipes = pd.read_csv('recipes.csv')


recipes


recipes.iloc[0]


#so my work is to make a list of the ingrdient of making a recipe 
recipes.ingredients.str.len().describe()#so here we are taking description of the recipes ingrdients lenght of the full data


#so max chracters are 625 and average chracters is 226 and no of ingrdients of the recipes in the data is 1090


#let find which recipe have 625 character of ingridient 
recipes.recipe_name[np.argmax(recipes.ingredients.str.len().describe())]


#so the recipe with the highest number of ingredients is apple cranberry  crostada


#letss find the withe lowest character 
recipes.recipe_name[np.argmin(recipes.ingredients.str.len().describe())]


#apple crisp is with lowest 


#finding how many of them is including inn the the ingridients
recipes.ingredients.str.contains('[Cc]innamon').sum()


#finding how many of them has misppeled as cinamon 
recipes.ingredients.str.contains('[Cc]inamon').sum()#so there isnt any


recipes.ingredients.str.contains('[Ss]alt').sum()


#lets check how many  recipes take one hour to cook 
recipes.cook_time.str.contains('1 [HRhr]').sum()#so there are 137 dishes which are taking exactly 1 hr to make 






