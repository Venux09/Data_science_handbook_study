df5 = pd.DataFrame({'group': ['Accounting', 'Accounting',
'Engineering', 'Engineering', 'HR', 'HR'],
                'skills': ['math', 'spreadsheets', 'software', 'math',
'spreadsheets', 'organization']})


display('df1','df5')


pd.merge(df1,df5)


#so till now we understood how one on one , many on one , and many to many  works in the pandas for merging the data frames which matches


#the speicification keys in the pandas 
pd.merge(df1,df5, on='group')


