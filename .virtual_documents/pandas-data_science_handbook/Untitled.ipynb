#data aggregation on multiple indices 


import pandas as pd 
import numpy as np 


#creating heirarchical index for the index and columns 
index = pd.MultiIndex.from_product([[2013,2014],[1,2]],
                                  names= ['year','visit']
                                )
columns = pd.MultiIndex.from_product([['Bob','Suzy','Michael'],['HR','Temp']],
                                    names = ['Name','Type'])

#making a fake data 
data = np.round(np.random.randn(4,6),1)#here we are making an array of 4,6 size and rounding that to 1 digit
data[:,::2] *= 10
data += 37

#creating the data frame 
health_data = pd.DataFrame(data,index = index , columns = columns)


health_data


#concating and appending the data sets 


import pandas as pd 
import numpy as np 


#function for making concated data frames 
def make_df(cols,ind):
    "Makes a quick Data frames"
    data = {c:[str(c)+str(1) for i in ind] for c in cols}
    return pd.DataFrame(data,ind)


make_df('ABC',range(3))


#making a class that will allow use to use multiple data frames side by side 
class display(object):
    """Display HTML representation of multiple objects"""
    template = """<div style="float: left; padding: 10px;">
    <p style='font-family:"Courier New", Courier, monospace'>{0}{1}
    """
    def __init__(self,*args):#storing all the arguments means variable etc 
        self.args = args

    def _repr_html_(self):
        return '\n'.join(self.template.format(a,eval(a)._repr_html_()) for a in self.args)

    



