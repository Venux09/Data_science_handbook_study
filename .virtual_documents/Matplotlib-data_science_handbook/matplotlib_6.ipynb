#importing the dataset that was already established in the Scikit Learn 
from sklearn.datasets import load_digits
digits = load_digits(n_class=6)


fig , ax = plt.subplots(8 , 8 , figsize = (6,6))#making a subplot of 8 , 8 size 
for i , axi in enumerate(ax.flat):#range or size whatever 
    axi.imshow(digits.images[i] , cmap = 'binary')#binary cmap for the representation 
    axi.set(xticks = [] ,  yticks = [])


