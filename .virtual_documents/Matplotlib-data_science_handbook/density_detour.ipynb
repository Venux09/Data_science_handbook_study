


%matplotlib inline 
import matplotlib.pyplot as plt 
import numpy as np 
import pandas as pd  
plt.style.use('seaborn-v0_8-white')


#lets start plotting some color coded contour 
plt.style.available


def f(x,y):
    "Defining the values of the function that we will make out of our raw x and y values "
    return np.sin(x)**10+np.cos(10+x*y)*np.cos(x) 


#value of x and y 
x = np.linspace(0,5,50)
y = np.linspace(0,5,50)
X,Y = np.meshgrid(x,y)#meshgrid what i searched means that it change our 1dimensional array to 2D relation that can happen at the graph 
Z = f(X,Y) #now we will make the Z function which is basically functon we have putted on the vales of the x and y 


#plotting the Contour contour fuction 
plt.contour(X,Y,Z, cmap = 'RdGy' )





#option that we have in the color map 
# plt.cm.


#plotting it with the color bar as well 
plt.contour(X,Y,Z , cmap = 'RdGy')
plt.colorbar()



#this graph look like it have so much descrete values lets make is more uniform so we can get a proper scence to choose sume result on the set of the values 


#plt.imshow does not accept the x and y so we have given extent of x and y 
#

plt.imshow(Z , extent = [0,5,0,5] , origin = 'lower' , cmap = 'RdGy' , interpolation='Gaussian',aspect = 'equal')
plt.colorbar()








#just plotting the simple histogram with random x and y relation 
import pandas as pd 
import numpy as np 
import matplotlib.pyplot as plt 

rng = np.random.default_rng(1700)
data = rng.normal(size = 1000)

plt.hist(data,bins = 5)



#it can be tuned both in maths and its display.
plt.hist(data,bins = 30 , alpha = 0.8 , color = 'steelblue' , histtype = 'stepfilled' , edgecolor = None )


#most imp inn  the histgram graphs are to be tuned are colors,transparecy and step filled they can 
#useful for both in  tunning the seeing the methods applied in the histograms 


#plotting multiple data plots or histogram on the single one to compare them on similar metrics - useful tecnique
x1 = rng.normal(0, 0.8, 1000)
x2 = rng.normal(-2, 1, 1000)
x3 = rng.normal(3, 2, 1000)

kwargs = dict(histtype = 'stepfilled',alpha = 0.7 , density = True , bins = 40)


plt.hist(x1 , **kwargs)
plt.hist(x2 , **kwargs)
plt.hist(x3 , **kwargs)


#for the computation onn the data using the numpy 
counts, bin_edges = np.histogram(data,bins = 5)


counts


bin_edges


#two dimensional histograms and binning of the data 


#multi Variate Gaussian Distribute 
mean = [0 , 0 ]
cov = [[1,1],[1,2]]

x , y = rng.multivariate_normal(mean , cov , 1000).T


#making the 2D histogram 
plt.hist2d(x , y , bins=30 , color = 'black')
cp = plt.colorbar()#explicit colorbar for madification 
cp.set_label('counts in bin')


# #computind the 2d graph 
# counts , xedges , yedges = np.histogram2d(x  , y , bins = 30)#just like we did in 1d histgram to compute the graph 
# counts,xedges,yedges


#lets make it a hexagonal so that it will not look like tensally squares 
plt.hexbin(x , y , gridsize = 30)
cb = plt.colorbar(label = 'count in bin')


#another methods for showing the density in the pandas 


#kernal density Estimation


from scipy.stats import gaussian_kde


rom scipy.stats import gaussian_kde
 # fit an array of size [Ndim, Nsamples]
 data = np.vstack([x, y])
 kde = gaussian_kde(data)
 # evaluate on a regular grid
 xgrid = np.linspace(-3.5, 3.5, 40)
 ygrid = np.linspace(-6, 6, 40)
 Xgrid, Ygrid = np.meshgrid(xgrid, ygrid)
 Z = kde.evaluate(np.vstack([Xgrid.ravel(), Ygrid.ravel()]))
 # Plot the result as an image
 plt.imshow(Z.reshape(Xgrid.shape),
 origin='lower', aspect='auto',
 extent=[-3.5, 3.5, -6, 6])
 cb = plt.colorbar()
 cb.set_label("density")



