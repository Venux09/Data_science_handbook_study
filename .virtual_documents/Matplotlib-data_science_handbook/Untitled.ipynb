#three dimensional plotting in the matplotlib 


from mpl_toolkits import mplot3d 


%matplotlib inline 
import matplotlib.pyplot as plt 
import numpy as np 
import pandas as pd 

fig = plt.figure()
ax = plt.axes(projection = '3d')



#data for the three - dimensional lines 
zline = np.linspace(0 , 15 , 1000)
xline = np.sin(zline)
yline = np.cos(zline)

ax.plot3D(xline,yline,zline , 'gray')

#data for the three dimesional scatterd points 
zdata = 15*np.random.random(100)
xdata = np.sin(zdata)+0.1*np.random.random(100)
ydata = np.cos(zdata)+0.1*np.random.random(100)
ax.scatter3D(xdata,ydata,zdata, c = zdata , cmap='Greens')






