#so instead of rengenerring everything you are now running more tests 


#so here the p is 90 as you thinked we will solve this problem using the binomial theorm to solve what is the probability of getting a 8 success as perameter 
# has been seeted as if 90 percent is the probability of the success


#using scipy for solving the binom dist 
from scipy.stats import binom 


#number of trials
n = 10
#probability 
p = 0.9

for k in range(n+1):
    #k is the range of the number we have setted previously
    probability = binom.pmf(k,n,p)#here pmf stands for the probability mass function 
    print('{0}-{1}'.format(k,probability))
    



