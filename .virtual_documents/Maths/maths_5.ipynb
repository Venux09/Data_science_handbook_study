#chain rule in the python for  2 function 
from sympy import * 

x,y = symbols('x y')


_y = x**2+1 #here is differentiation which y respect to x 
diff_y = diff(_y)
z = y**2+1
diff_z = diff(z)#here is differentiation of z with respect to y 

z_to_x = (diff_z*diff_y).subs(y,_y) #in this y will cut out and it will give relation from z to x 
z_to_x




