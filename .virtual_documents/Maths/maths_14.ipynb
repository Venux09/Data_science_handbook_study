








def variance(values):
    mean = sum(values)/len(values)#mean formula in the python 

    _variance = (sum((v-mean)**2 for v in values)/len(values))#variance formula in the python 

    return _variance 
from math import sqrt 
def std_deviation(values):
    return sqrt(variance(values))


def mean(samples):
    mean = sum(samples)/len(samples)
    return mean 


#probability density functon. 
#it basically means it show the normal distribution fuction and show the density of the probability at any other points 
def normal_pdf(x:float ,variance:float, mean:float ):
    "IT is funcition based on the formula of the probability density in the stats"
    pdf = (1 / np.sqrt(2 * np.pi * variance)) * \
      np.exp(-(x - mean)**2 / (2 * variance))
    return pdf


