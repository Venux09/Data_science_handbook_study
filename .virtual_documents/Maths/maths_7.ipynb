#we have to find the area under the curve 

def approximate_integral(a,b,n,f):#n = no of rectangles divided to find the area under the curve
    delta_x = (b-a)/n
    total_sum = 0 


    for i in range(1,n+1):
        midpoint = 0.5 *(2*a+delta_x*(2*i-1))
        total_sum += f(midpoint)
    return total_sum*delta_x


def my_func(x):
    return x**2+1
    
%timeit area = approximate_integral(a=0,b=1,n=1,f=my_func)
area


