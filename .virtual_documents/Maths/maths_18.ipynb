#the value of the x{days} of the area where 5 percent data is behind it 
from scipy.stats import norm 
mean = 18 # mean 
std = 1.5 #standart deviation 
x_value = norm.ppf(0.05,mean,std)


x_value#approx - 15.53 days is the x value behind the area of 5 percent data 


#find the p value for the actual 16 days 
y_value = norm.cdf(16,mean,std)


y_value#it is bigger than 0.05 that we want to prove that it have significance


#so this basically says that statistically we can't say that drug is working it can be just random luck this is the conclusion of the one  tail test 


#two tailed test 


