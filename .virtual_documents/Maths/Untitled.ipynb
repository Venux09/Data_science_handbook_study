#integration of the area under the curve 
from sympy import *

#i=indexes of the each rectange of their postion , n = no of rectangeles , x = each rectangles 
x,i,n = symbols('x i n')#symbols 

#function and upper or lower limit 
f = x**2+1 
lower, upper = 0,1 #limits of the area of the graph 

delta_x = (upper-lower)/n 
x_i = (delta_x+x/n)
f_xi = f.subs(x,x_i)


#n_rectangles 
n_rectangles = Sum(delta_x*f_xi,(i,1,n)).doit()





#area under the curve
area = limit(n_rectangles,n,oo)
area


