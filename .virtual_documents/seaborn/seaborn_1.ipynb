


 
import numpy as np 
import pandas as pd 
import matplotlib.pyplot as plt 
import seaborn as sns 

sns.set()


data = np.random.multivariate_normal([0, 0], [[5, 2], [2, 2]], size=2000)
data = pd.DataFrame(data, columns=['x', 'y'])

for col in  'xy':
    plt.hist(data[col] , density = True , alpha = 0.5)


#now plotting that with the sns for smoother version 
sns.kdeplot(data = data , shade = True
           )


#lets try other methods with this 


#plotting the x and y relationship between the x and y 
sns.kdeplot(data = data , x = 'x' , y = 'y')


#let work with some well known data also know as iris dataset 
iris = sns.load_dataset('iris')
sns.pairplot(iris,hue = 'species' , height = 2.5)


#plotting the facet grid using the searborn which is also the way to show the comparsion with the code 


tips = sns.load_dataset('tips')
tips['tips_pct'] = 100*tips['tip']/tips['total_bill']

grid = sns.FacetGrid(tips , row='sex' , col = 'time' , margin_titles = True)

grid.map(plt.hist , 'tips_pct' , bins = np.linspace(0,40 , 15))



#bar plots using the searborn 


planets = sns.load_dataset('planets')
with sns.axes_style('white'):
    g = sns.catplot(x = 'year' , data = planets , kind = 'count' , color = 'stealblue')
    g.set_xtickslabels(5)



