#stochastic Gradient decent 


#performing the stochastic Gradient decent on  Linear Regression 


# Input data
data = pd.read_csv('https://bit.ly/2KF29Bd', header=0)
X = data.iloc[: , 0]#values for the x axis 
Y = data.iloc[: , 1]#values for the y values 
n = data.shape[0]
#building the model 
m = 0 
b = 0 

#sample size 
sample_size = 1

#Learning rate 
L = 000.1

#iteration means basically how many times this model will run 
epoches = 1_000_000

#peforming the Stochastic Gradient decent 
for i in range(epoches):
    idx = np.random.choice(n , sample_size , replace  = False)
    x_sample = X[idx]
    y_sample = Y[idx]

    #current predicted values 
    Y_pred  = m*x_sample+b

    #dervative d/dm of the finding the loss fucntiom 
    D_m = (-2/sample_size)*sum(x_sample * (y_sample-Y_pred))

    #d/db of the loss fucntion 
    D_b = (-2/sample_size)*sum(y_sample-Y_pred)

    #updated m and b 
    m = m-L*D_m
    b = b-L*D_b

    





