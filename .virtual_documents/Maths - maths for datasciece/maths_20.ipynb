#eigendecompostion - it is phenomenon where we have to decompose means breat the matrix in smaller parts so that we can work with different tasks of the machine learning
#it work with square  matrix only where rows and colums are same 








#lets decompose a proper vector into these values so that we can work with it 
from numpy import array , diag
from numpy.linalg import eig , inv 


#let make a array  
A = array([[1,2],[4,5]])


eigval,eigvect = eig(A)


#it can be only performed on the square that was already discussed 


print(f'Eigvector - {eigvect}') , print(f'Eigvalues - {eigval}')





#so now i will try to reconstruct the matrix that we have decomposed earlier 
Q = eigvect 
R = inv(Q)


L = diag(eigval)


#now apply the formula here 
M = Q*L*R


M








